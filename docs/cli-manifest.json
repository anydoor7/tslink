{
  "schema_version": 1,
  "registry_schema_version": 1,
  "toolchain": {
    "minimum_go_version": "1.26.5",
    "goreleaser_version": "v2.17.0",
    "homebrew_artifact": "cask"
  },
  "exit_codes": {
    "auth": 3,
    "conflict": 4,
    "critical": 65,
    "error": 1,
    "not_found": 5,
    "success": 0,
    "usage": 2,
    "warning": 64
  },
  "registry_schema": {
    "version": 1,
    "service_types": [
      "proxy",
      "file",
      "tcp"
    ],
    "required_fields": [
      "schema_version",
      "services[].name",
      "services[].type"
    ],
    "unavailable_features": [
      "custom-domain/ACME fields are reserved and rejected with feature_unavailable",
      "middleware schema is reserved and rejected with feature_unavailable"
    ]
  },
  "api_actions": [
    "list",
    "add",
    "remove",
    "status",
    "doctor",
    "access_explain",
    "template_list",
    "template_plan",
    "template_apply"
  ],
  "credential_sources": {
    "recommended": [
      {
        "id": "interactive_login",
        "command": "tslink login",
        "boundary": "normal path; prompts avoid putting secrets in argv or shell history"
      }
    ],
    "automation": [
      {
        "id": "api_key_stdin",
        "command": "tslink login --api-key-stdin",
        "flags": [
          "--api-key-stdin"
        ],
        "boundary": "read API token from stdin; keep secret out of argv"
      },
      {
        "id": "client_secret_stdin",
        "command": "tslink login --client-secret-stdin",
        "flags": [
          "--client-secret-stdin"
        ],
        "boundary": "read OAuth client secret from stdin; keep secret out of argv"
      },
      {
        "id": "environment",
        "environment": [
          "TSLINK_API_KEY",
          "TSLINK_CLIENT_SECRET"
        ],
        "boundary": "acceptable for secret-manager injected automation; do not hard-code in shell history or source"
      }
    ],
    "avoid": [
      {
        "id": "argv_flags",
        "flags": [
          "--api-key",
          "--client-secret"
        ],
        "boundary": "accepted for compatibility, but secrets in argv can be exposed through shell history or local process inspection"
      },
      {
        "id": "manual_secret_file_write",
        "boundary": "direct echo/printf writes can leak through shell history and create files before permissions converge; prefer tslink login stdin paths"
      }
    ],
    "storage": [
      {
        "id": "system_keychain",
        "boundary": "preferred storage: macOS Keychain, Linux Secret Service, or Windows Credential Manager"
      },
      {
        "id": "restricted_file_fallback",
        "boundary": "headless fallback uses user-only restricted files when keychain storage is unavailable"
      }
    ]
  },
  "high_risk_operations": [
    {
      "command": "tslink login",
      "operation": "remote ACL tag-owner mutation",
      "default": "disabled",
      "required_flags": [
        "--manage-acl"
      ],
      "boundary": "default login does not rewrite shared tailnet ACL policy"
    },
    {
      "command": "tslink serve",
      "operation": "startup remote ACL tag ensure",
      "default": "disabled",
      "required_flags": [
        "--manage-acl"
      ],
      "boundary": "default serve does not rewrite shared tailnet ACL policy"
    },
    {
      "command": "tslink tags delete-remote",
      "operation": "remote ACL tag-owner deletion",
      "default": "disabled",
      "required_flags": [
        "--force",
        "--manage-acl"
      ],
      "boundary": "requires destructive confirmation and explicit remote ACL opt-in"
    }
  ],
  "release": {
    "public_release_available": false,
    "prebuilt_available": false,
    "homebrew_tap_available": false,
    "local_source_install": "go install . from a checked-out source tree before the first public release",
    "external_gates": [
      "hosted exact-SHA CI readback",
      "GitHub release environment reviewer/ruleset readback",
      "first tag/release artifact readback",
      "Homebrew tap readback"
    ]
  },
