  "capabilities": {
    "schema_version": 1,
    "product": "tslink",
    "capabilities": [
      {
        "id": "transport.proxy.tailnet",
        "service_type": "proxy",
        "tailnet_transport": "tailscale_wireguard_to_service_node",
        "tslink_tls_termination": "tailscale_https_listener",
        "backend_hop": "plain_http_or_https_as_configured_by_proxy_target",
        "whois_propagation": "best_effort_identity_headers_when_whois_succeeds",
        "whois_cache": "60s_by_source_ip",
        "allow_authorization": "http_fail_closed_when_configured",
        "public_exposure": "private_by_default_funnel_requires_explicit_public_ack",
        "log_sink": "process_slog",
        "log_schema": "access_v1_no_caller_identity_fields",
        "host_isolation": "not_provided",
        "compliance_status": "not_certified"
      },
      {
        "id": "transport.file.tailnet",
        "service_type": "file",
        "tailnet_transport": "tailscale_wireguard_to_service_node",
        "tslink_tls_termination": "tailscale_https_listener",
        "backend_hop": "local_filesystem_read",
        "whois_propagation": "none_without_allow_list",
        "whois_cache": "none",
        "allow_authorization": "http_fail_closed_when_configured",
        "public_exposure": "private_tailnet_only",
        "log_sink": "process_slog",
        "log_schema": "access_v1_no_caller_identity_fields",
        "host_isolation": "not_provided",
        "compliance_status": "not_certified"
      },
      {
        "id": "transport.tcp.tailnet",
        "service_type": "tcp",
        "tailnet_transport": "tailscale_wireguard_to_service_node",
        "tslink_tls_termination": "none_raw_tcp_stream",
        "backend_hop": "plain_tcp_to_configured_target",
        "whois_propagation": "not_applicable",
        "whois_cache": "not_applicable",
        "allow_authorization": "not_applicable_rejected_for_tcp",
        "public_exposure": "private_tailnet_only",
        "log_sink": "process_slog",
        "log_schema": "tcp_events_no_http_identity_fields",
        "host_isolation": "not_provided",
        "compliance_status": "not_certified"
      },
      {
        "id": "exposure.proxy.funnel",
        "service_type": "funnel",
        "tailnet_transport": "tailscale_funnel_semantics",
        "tslink_tls_termination": "tailscale_funnel_listener",
        "backend_hop": "plain_http_or_https_as_configured_by_proxy_target",
        "whois_propagation": "not_treated_as_tslink_enforced_tailscale_user_authentication",
        "whois_cache": "not_applicable",
        "allow_authorization": "not_supported_with_funnel_public_exposure",
        "public_exposure": "public_internet_after_explicit_ack",
        "log_sink": "process_slog",
        "log_schema": "access_v1_no_caller_identity_fields",
        "host_isolation": "not_provided",
        "compliance_status": "not_certified"
      }
    ]
  }
}
